generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique
  password       String
  name           String
  email          String?   @unique
  phone          String
  churchName     String    @map("church_name")
  position       String
  category       String?
  role           String    @default("pending")
  isApproved     Boolean   @default(false) @map("is_approved")
  approvedBy     Int?      @map("approved_by")
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason")
  rejectedAt     DateTime? @map("rejected_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastLoginAt    DateTime? @map("last_login_at")
  comments       Comment[]
  likes          Like[]
  posts          Post[]

  @@map("users")
}

model StandingCommittee {
  id            Int      @id @default(autoincrement())
  name          String
  headTitle     String   @map("head_title")
  head          String
  headRole      String   @map("head_role")
  secretary     String
  secretaryRole String   @map("secretary_role")
  members       String
  term          String
  displayOrder  Int      @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("standing_committees")
}

model Settings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model SeparateRegistry {
  id                 Int      @id @default(autoincrement())
  name               String
  position           String
  birthDate          String   @map("birth_date")
  registrationDate   String   @map("registration_date")
  registrationReason String   @map("registration_reason")
  cancellationDate   String   @map("cancellation_date")
  cancellationReason String   @map("cancellation_reason")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("separate_registries")
}

model Rule {
  id        Int      @id @default(autoincrement())
  type      String   @unique
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rules")
}

model Resolution {
  id           Int      @id @default(autoincrement())
  tabType      String   @map("tab_type")
  meetingNum   Int      @map("meeting_num")
  sessionNum   Int?     @map("session_num")
  meetingType  String   @default("정기") @map("meeting_type")
  title        String
  fileType     String   @map("file_type")
  fileName     String   @map("file_name")
  fileUrl      String   @map("file_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("resolutions")
}

model FeeStatus {
  id         Int      @id @default(autoincrement())
  inspection String
  churchName String   @map("church_name")
  pastorName String   @map("pastor_name")
  monthlyFee Int      @map("monthly_fee")
  annualFee  Int      @map("annual_fee")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("fee_statuses")
}

model Post {
  id           Int          @id @default(autoincrement())
  boardType    String       @map("board_type")
  title        String
  content      String
  authorId     Int          @map("author_id")
  authorName   String?      @map("author_name")
  viewCount    Int          @default(0) @map("view_count")
  isNotice     Boolean      @default(false) @map("is_notice")
  category     String?      @map("category")
  displayOrder Int          @default(0) @map("display_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  attachments  Attachment[]
  comments     Comment[]
  likes        Like[]
  author       User         @relation(fields: [authorId], references: [id])

  @@map("posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  postId    Int      @map("post_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  author    User     @relation(fields: [authorId], references: [id])
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
  @@map("likes")
}

model Attachment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  fileName  String   @map("file_name")
  fileUrl   String   @map("file_url")
  fileSize  Int      @map("file_size")
  mimeType  String?  @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model Popup {
  id          Int      @id @default(autoincrement())
  title       String
  contentHtml String?  @map("content_html")
  imageUrl    String?  @map("image_url")
  linkUrl     String?  @map("link_url")
  startAt     DateTime @map("start_at")
  endAt       DateTime @map("end_at")
  isActive    Boolean  @default(true) @map("is_active")
  priority    Int      @default(0)
  width       Int?     @default(400)
  height      Int?     @default(500)
  positionX   Int?     @map("position_x")
  positionY   Int?     @map("position_y")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("popups")
}

model BoardSettings {
  id         Int      @id @default(autoincrement())
  boardType  String   @unique @map("board_type")
  categories String   @default("[]")
  settings   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("board_settings")
}

model HeroConfig {
  id                    Int      @id @default(autoincrement())
  name                  String
  isActive              Boolean  @default(false) @map("is_active")
  backgroundImage       String?  @map("background_image")
  backgroundImageMobile String?  @map("background_image_mobile")
  animationType         String   @default("static") @map("animation_type")
  animationSpeed        String   @default("normal") @map("animation_speed")
  hideText              Boolean  @default(false) @map("hide_text")
  titleText             String?  @map("title_text")
  titleColor            String?  @default("#ffffff") @map("title_color")
  titleAnimation        String?  @default("none") @map("title_animation")
  subtitleText          String?  @map("subtitle_text")
  motto1                String?
  motto2                String?
  motto3                String?
  descriptionText       String?  @map("description_text")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  backgroundVideo       String?  @map("background_video")

  @@index([isActive])
  @@map("hero_configs")
}

model FeePaymentAccount {
  id            Int      @id @default(autoincrement())
  title         String
  bank          String
  accountNumber String   @map("account_number")
  accountHolder String   @map("account_holder")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("fee_payment_accounts")
}

model MediaFolder {
  id        String        @id @default(uuid())
  name      String
  parentId  String?       @map("parent_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  assets    FileAsset[]
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderHierarchy")

  @@unique([name, parentId])
  @@map("media_folders")
}

model FileAsset {
  id          String       @id @default(uuid())
  filename    String
  storedName  String       @unique @map("stored_name")
  mimeType    String       @map("mime_type")
  size        Int
  width       Int?
  height      Int?
  altText     String?      @map("alt_text")
  caption     String?
  description String?
  path        String
  provider    String
  hash        String?      @unique
  folderId    String?      @map("folder_id")
  uploadedBy  Int?         @map("uploaded_by")
  uploadedAt  DateTime     @default(now()) @map("uploaded_at")
  folder      MediaFolder? @relation(fields: [folderId], references: [id])

  @@index([mimeType])
  @@index([uploadedAt])
  @@map("file_assets")
}

model ContentBlock {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_blocks")
}
